# Local infrastructure only. Copy to .env and change values outside shared demos.
D3_POSTGRES_PORT=5432
D3_POSTGRES_HOST=localhost
D3_POSTGRES_ADMIN_USER=d3_admin
D3_POSTGRES_ADMIN_PASSWORD=local-admin
D3_SERVICE_DB_PASSWORD=local-only
D3_REDIS_PORT=6379
D3_REDIS_HOST=localhost
D3_KAFKA_PORT=9092
D3_KAFKA_HOST=localhost
D3_PROMETHEUS_PORT=9090
D3_GRAFANA_PORT=3000
D3_WEB_URL=http://localhost:5173
D3_WEB_ORIGIN=http://localhost:5173
D3_GATEWAY_HEALTH_URL=http://localhost:8080/actuator/health
D3_IDENTITY_HEALTH_URL=http://localhost:8081/actuator/health
D3_BATTLE_HEALTH_URL=http://localhost:8082/actuator/health
D3_JUDGE_SERVICE_HEALTH_URL=http://localhost:8083/actuator/health
D3_COMMUNITY_HEALTH_URL=http://localhost:8084/actuator/health
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=local-admin

# Runtime bindings activated later.
CONFIG_SERVER_URL=http://localhost:8888
EUREKA_URL=http://localhost:8761/eureka/
D3_EUREKA_INSTANCE_HOSTNAME=127.0.0.1
D3_EUREKA_INSTANCE_IP_ADDRESS=127.0.0.1
D3_CONFIG_HEALTH_URL=http://localhost:8888/actuator/health
D3_DISCOVERY_HEALTH_URL=http://localhost:8761/actuator/health
IDENTITY_DB_USER=d3_identity
BATTLE_DB_USER=d3_battle
JUDGE_DB_USER=d3_judge
COMMUNITY_DB_USER=d3_community
JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_ALLOWED_ORIGIN=http://localhost:2358
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_AUTH_TOKEN=
SPRING_PROFILES_ACTIVE=local
SERVER_ADDRESS=127.0.0.1
D3_JUDGE_ADAPTER=fake

# Rehearsal-only demo account password. Empty means no demo users are seeded.
# Supply through the agreed secret handoff; never commit a real value.
D3_SEED_DEMO_PASSWORD=
D3_JWT_JWK_SET_URI=http://localhost:8081/.well-known/jwks.json
D3_JWT_ISSUER=http://localhost:8081
# Required outside local/test profiles. Store the private RSA JWK in the deployment secret source.
D3_JWT_SIGNING_JWK=
D3_JWT_CLOCK_SKEW=30s
D3_REFRESH_COOKIE_SECURE=false
D3_JWT_JUDGE_AUDIENCE=judge-service
D3_JWT_USER_AUDIENCE=d3-user
D3_JWT_JUDGE_CLIENT_ID=battle-service
D3_JWT_SERVICE_TOKEN_USE=service
D3_JWT_SERVICE_TOKEN_TTL=5m
D3_BATTLE_SERVICE_CLIENT_SECRET=
D3_IDENTITY_INTERNAL_URL=
AWS_REGION=ap-northeast-2
