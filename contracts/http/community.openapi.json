{
  "openapi": "3.1.0",
  "info": {
    "title": "D3 Community API",
    "version": "0.4.0",
    "description": "P0 public developer feed and privacy-safe match record contract, plus the P1 social interactions (follow, like, comment), FOLLOWERS-visibility posts, and a following feed activated over the already-recognized persistence. Markdown rendering is a safe minimal subset: paragraphs, line breaks, and fenced code blocks."
  },
  "x-requirements": ["D3-COM-001", "D3-STAT-001", "D3-SEC-001"],
  "paths": {
    "/v1/community/posts": {
      "post": {
        "summary": "Create a Markdown post (PUBLIC or FOLLOWERS visibility)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreatePostRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created post",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Post" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" }
        }
      }
    },
    "/v1/community/feed": {
      "get": {
        "summary": "List public feed posts with keyset pagination",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "Public feed page",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FeedPage" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/v1/community/following-feed": {
      "get": {
        "summary": "List posts authored by users the viewer follows (PUBLIC and FOLLOWERS) with keyset pagination",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "Following feed page; FOLLOWERS posts appear only for followers of the author",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FeedPage" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/v1/community/profiles": {
      "get": {
        "summary": "Search public profiles by handle prefix with keyset pagination",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "handle", "in": "query", "required": true, "schema": { "type": "string", "minLength": 1 } },
          { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "Matching public profiles",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProfilePage" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/v1/community/matches/{matchId}": {
      "get": {
        "summary": "Read one ACTIVE public match record",
        "security": [],
        "parameters": [
          { "name": "matchId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Public match record",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MatchRecord" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/community/players/{playerId}/matches": {
      "get": {
        "summary": "List one player's ACTIVE public match records with keyset pagination",
        "security": [],
        "parameters": [
          { "name": "playerId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "Public player match page",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MatchRecordPage" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" }
        }
      }
    },
    "/v1/community/follows": {
      "post": {
        "summary": "Follow another user",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FollowRequest" }
            }
          }
        },
        "responses": {
          "204": { "description": "Follow recorded; repeating an existing follow is an idempotent no-op" },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/ProfileNotFound" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" }
        }
      }
    },
    "/v1/community/follows/{followedUserId}": {
      "delete": {
        "summary": "Unfollow a user",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "followedUserId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "204": { "description": "Follow removed; removing a missing follow is an idempotent no-op" },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/v1/community/profiles/{userId}/follow-state": {
      "get": {
        "summary": "Read follow counts and the viewer's follow state for a user",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Follow state",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FollowState" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/v1/community/posts/{postId}/likes": {
      "post": {
        "summary": "Like a public post",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "postId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "204": { "description": "Like recorded; repeating an existing like is an idempotent no-op" },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/PostNotFound" }
        }
      },
      "delete": {
        "summary": "Remove a like from a public post",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "postId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "204": { "description": "Like removed; removing a missing like is an idempotent no-op" },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/PostNotFound" }
        }
      }
    },
    "/v1/community/posts/{postId}/like-state": {
      "get": {
        "summary": "Read like count and the viewer's like state for a post",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "postId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Like state",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LikeState" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/PostNotFound" }
        }
      }
    },
    "/v1/community/posts/{postId}/comments": {
      "post": {
        "summary": "Add a comment to a public post",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "postId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateCommentRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created comment",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Comment" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/PostNotFound" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" }
        }
      },
      "get": {
        "summary": "List a public post's comments with keyset pagination",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "postId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "Comment page",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CommentPage" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/PostNotFound" }
        }
      }
    },
    "/v1/community/posts/{postId}/comments/{commentId}": {
      "delete": {
        "summary": "Delete the viewer's own comment",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "postId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "commentId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "204": { "description": "Comment deleted" },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/CommentNotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "responses": {
      "InvalidRequest": {
        "description": "Invalid request",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Unauthorized": {
        "description": "Authentication required",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "Match record not found",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "PayloadTooLarge": {
        "description": "Request body is too large",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "PostNotFound": {
        "description": "Post is not a public post or does not exist (code POST_NOT_FOUND)",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "CommentNotFound": {
        "description": "Comment does not exist under this post or is not owned by the requester (code COMMENT_NOT_FOUND)",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "ProfileNotFound": {
        "description": "Follow target has no known Community identity projection (code PROFILE_NOT_FOUND)",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "schemas": {
      "CreatePostRequest": {
        "type": "object",
        "required": ["markdown"],
        "properties": {
          "markdown": { "type": "string", "minLength": 1 },
          "visibility": { "$ref": "#/components/schemas/PostVisibility" }
        },
        "additionalProperties": false
      },
      "PostVisibility": {
        "type": "string",
        "enum": ["PUBLIC", "FOLLOWERS", "CIRCLE", "PRIVATE"],
        "description": "Post creation accepts PUBLIC and FOLLOWERS; CIRCLE and PRIVATE are recognized by persistence but not yet activated at the interface."
      },
      "Post": {
        "type": "object",
        "required": ["id", "authorUserId", "authorHandle", "visibility", "markdown", "renderedHtml", "proseCharacterCount", "matchId", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "authorUserId": { "type": "string", "format": "uuid" },
          "authorHandle": { "type": ["string", "null"], "minLength": 1 },
          "visibility": { "$ref": "#/components/schemas/PostVisibility" },
          "markdown": { "type": "string" },
          "renderedHtml": { "type": "string" },
          "proseCharacterCount": { "type": "integer", "minimum": 0 },
          "matchId": { "type": ["string", "null"], "format": "uuid" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "FeedPage": {
        "type": "object",
        "required": ["posts"],
        "properties": {
          "posts": { "type": "array", "items": { "$ref": "#/components/schemas/Post" } },
          "nextCursor": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      },
      "MatchRecord": {
        "type": "object",
        "required": ["matchId", "playerOneUserId", "playerTwoUserId", "result", "ranked", "sourceVersion", "projectedAt"],
        "properties": {
          "matchId": { "type": "string", "format": "uuid" },
          "playerOneUserId": { "type": "string", "format": "uuid" },
          "playerTwoUserId": { "type": "string", "format": "uuid" },
          "result": { "type": "string", "enum": ["PLAYER_ONE_WIN", "PLAYER_TWO_WIN", "DRAW", "VOIDED"] },
          "ranked": { "type": "boolean" },
          "sourceVersion": { "type": "integer", "minimum": 0 },
          "projectedAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "MatchRecordPage": {
        "type": "object",
        "required": ["matches", "nextCursor"],
        "properties": {
          "matches": { "type": "array", "items": { "$ref": "#/components/schemas/MatchRecord" } },
          "nextCursor": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      },
      "ProfileView": {
        "type": "object",
        "required": ["userId", "handle"],
        "properties": {
          "userId": { "type": "string", "format": "uuid" },
          "handle": { "type": "string", "minLength": 1 },
          "publicRating": { "type": ["integer", "null"] },
          "tier": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      },
      "ProfilePage": {
        "type": "object",
        "required": ["profiles", "nextCursor"],
        "properties": {
          "profiles": { "type": "array", "items": { "$ref": "#/components/schemas/ProfileView" } },
          "nextCursor": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      },
      "FollowRequest": {
        "type": "object",
        "required": ["followedUserId"],
        "properties": {
          "followedUserId": { "type": "string", "format": "uuid" }
        },
        "additionalProperties": false
      },
      "FollowState": {
        "type": "object",
        "required": ["followerCount", "followingCount", "viewerFollowing"],
        "properties": {
          "followerCount": { "type": "integer", "minimum": 0 },
          "followingCount": { "type": "integer", "minimum": 0 },
          "viewerFollowing": { "type": "boolean" }
        },
        "additionalProperties": false
      },
      "LikeState": {
        "type": "object",
        "required": ["likeCount", "viewerLiked"],
        "properties": {
          "likeCount": { "type": "integer", "minimum": 0 },
          "viewerLiked": { "type": "boolean" }
        },
        "additionalProperties": false
      },
      "CreateCommentRequest": {
        "type": "object",
        "required": ["markdown"],
        "properties": {
          "markdown": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "Comment": {
        "type": "object",
        "required": ["id", "postId", "authorUserId", "authorHandle", "bodyMarkdown", "renderedHtml", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "postId": { "type": "string", "format": "uuid" },
          "authorUserId": { "type": "string", "format": "uuid" },
          "authorHandle": { "type": ["string", "null"], "minLength": 1 },
          "bodyMarkdown": { "type": "string" },
          "renderedHtml": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "CommentPage": {
        "type": "object",
        "required": ["comments", "nextCursor"],
        "properties": {
          "comments": { "type": "array", "items": { "$ref": "#/components/schemas/Comment" } },
          "nextCursor": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "required": ["code", "message", "correlationId"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "correlationId": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
