{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d3.local/contracts/events/match-finished.v2.schema.json",
  "title": "match.finished.v2",
  "x-requirements": ["D3-BTL-003", "D3-BTL-005", "D3-STAT-001", "D3-SEC-001"],
  "allOf": [
    { "$ref": "./envelope.v2.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "match.finished" },
        "version": { "const": 2 },
        "data": {
          "type": "object",
          "required": ["matchId", "result", "ranked", "playerIds", "players"],
          "properties": {
            "matchId": { "type": "string", "format": "uuid" },
            "result": { "enum": ["PLAYER_ONE_WIN", "PLAYER_TWO_WIN", "DRAW", "VOIDED"] },
            "ranked": { "type": "boolean" },
            "playerIds": {
              "type": "array",
              "description": "Seat-ordered player IDs: index 0 is PLAYER_ONE and index 1 is PLAYER_TWO.",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "string", "format": "uuid" }
            },
            "players": {
              "type": "array",
              "description": "Seat-ordered, public record evidence. It deliberately excludes source, hidden tests, raw diagnostics, and attack payloads.",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/$defs/playerRecord" }
            }
          },
          "additionalProperties": false
        }
      }
    }
  ],
  "$defs": {
    "playerRecord": {
      "type": "object",
      "required": ["userId", "language", "attempts", "peakTier", "leaderboardPosition", "score", "execution", "attacks"],
      "properties": {
        "userId": { "type": "string", "format": "uuid" },
        "language": { "type": "string", "minLength": 1, "maxLength": 32 },
        "attempts": { "type": "integer", "minimum": 0 },
        "peakTier": { "type": "string", "minLength": 1, "maxLength": 32 },
        "leaderboardPosition": { "type": "integer", "minimum": 1 },
        "score": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["total", "speed", "dynamicEfficiency", "submissionDiscipline", "calculationVersion", "problemVersion", "runtimeVersion", "calibrationVersion"],
              "properties": {
                "total": { "type": "number" },
                "speed": { "type": "number" },
                "dynamicEfficiency": { "type": "number" },
                "submissionDiscipline": { "type": "number" },
                "calculationVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
                "problemVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
                "runtimeVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
                "calibrationVersion": { "type": "string", "minLength": 1, "maxLength": 128 }
              },
              "additionalProperties": false
            }
          ]
        },
        "execution": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["verdict", "passedCount", "totalCount", "runtimeMeasurements", "adapterVersion", "runtimeVersion", "evidenceVersion"],
              "properties": {
                "verdict": { "enum": ["ACCEPTED", "WRONG_ANSWER", "COMPILATION_ERROR", "RUNTIME_ERROR", "TIME_LIMIT", "MEMORY_LIMIT"] },
                "passedCount": { "type": "integer", "minimum": 0 },
                "totalCount": { "type": "integer", "minimum": 0 },
                "runtimeMeasurements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["tier", "inputSize", "sampleCount", "medianRuntimeMicros"],
                    "properties": {
                      "tier": { "type": "string", "minLength": 1, "maxLength": 32 },
                      "inputSize": { "type": "integer", "minimum": 0 },
                      "sampleCount": { "type": "integer", "minimum": 1 },
                      "medianRuntimeMicros": { "type": "integer", "minimum": 0 }
                    },
                    "additionalProperties": false
                  }
                },
                "adapterVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
                "runtimeVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
                "evidenceVersion": { "type": "string", "minLength": 1, "maxLength": 128 }
              },
              "additionalProperties": false
            }
          ]
        },
        "attacks": {
          "type": "object",
          "required": ["launched", "targeted", "blocked", "reflected"],
          "properties": {
            "launched": { "type": "integer", "minimum": 0 },
            "targeted": { "type": "integer", "minimum": 0 },
            "blocked": { "type": "integer", "minimum": 0 },
            "reflected": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
