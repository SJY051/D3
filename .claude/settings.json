{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/claude-post-edit.mjs",
            "timeout": 30,
            "statusMessage": "Checking shared agent guidance"
          }
        ]
      }
    ]
  }
}

